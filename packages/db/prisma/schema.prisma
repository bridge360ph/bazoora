generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  GOVERNMENT_ADMIN
  HAULING_ADMIN
  DRIVER
  ECO_AIDE
  BUSINESS
  RESIDENT
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  password        String
  role            UserRole
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  driverLocation  DriverLocation?  @relation("DriverLocations")
  assignedTruck   Truck?           @relation("AssignedDriver")
  assignedRoute   Route?           @relation("AssignedEcoAide")
}

model ServiceRequest {
  request_id      String    @id @default(cuid())
  user_id         String
  org_id          String?
  request_address String
  sender_type     String?
  image_url       String?
  pickup_date     DateTime?
  status          String    @default("PENDING")
  approved_by     String?
  approved_at     DateTime?
  note            String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    User     @relation("DriverLocations", fields: [driverId], references: [id])
  truckId   String?
  truck     Truck?   @relation("TruckLocations", fields: [truckId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id               String           @id @default(cuid())
  plateNumber      String           @unique
  model            String?
  capacity         String?
  status           String           @default("Active") // "Active" | "Idle" | "Under Maintenance"
  assignedDriverId String?          @unique
  assignedDriver   User?            @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  assignedRoute    Route?           @relation("RouteTruck")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  driverLocations  DriverLocation[] @relation("TruckLocations")
}

model Route {
  id                 String   @id @default(cuid())
  routeNumber        Int      @unique
  name               String
  barangay           String
  waypoints          String   // Comma separated list of stops/waypoints
  wasteType          String   // "Regular" | "Recyclable" | "Regular/Non-Recyclable"
  collectionDay      String   // "Sunday" | "Monday" ...
  startTime          String
  status             String   @default("Not Started") // "In Progress" | "Completed" | "Not Started"
  stops              Int      @default(0)
  routeType          String
  assignedEcoAideId  String?  @unique
  assignedEcoAide    User?    @relation("AssignedEcoAide", fields: [assignedEcoAideId], references: [id])
  assignedTruckId    String?  @unique
  assignedTruck      Truck?   @relation("RouteTruck", fields: [assignedTruckId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Counter {
  entity   String @id
  sequence Int    @default(0)
}

// Hauling Request Management

enum HaulingRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum WasteType {
  RESIDUAL
  NON_BIODEGRADABLE
  HAZARDOUS
  BIODEGRADABLE
}

enum SenderType {
  RESIDENT
  BUSINESS
}

model RequestCounter {
  id        String @id @default("hauling_request")
  lastValue Int    @default(0)
}

model HaulingRequest {
  requestId      String    @id @default(cuid())
  requestNumber  String    @unique
  userId         String
  orgId          String?
  requestAddress String
  senderType     SenderType
  wasteType      WasteType
  imageUrl       String?
  pickupDate     DateTime?
  status          HaulingRequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  denialReason   String?
  note            String?
  archived        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
