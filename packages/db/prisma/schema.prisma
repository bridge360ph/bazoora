generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  GOVERNMENT_ADMIN
  HAULING_ADMIN
  DRIVER
  ECO_AIDE
  BUSINESS
  RESIDENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HaulingRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum WasteType {
  RESIDUAL
  NON_BIODEGRADABLE
  HAZARDOUS
  BIODEGRADABLE
}

model HaulingRequest {
  request_id      String    @id @default(cuid())
  user_id         String
  org_id          String?
  request_address String
  sender_type     String?
  waste_type      WasteType
  image_url       String?
  pickup_date     DateTime?
  status          HaulingRequestStatus @default(PENDING)
  approved_by     String?
  approved_at     DateTime?
  denial_reason   String?
  note            String?
  archived        Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}
