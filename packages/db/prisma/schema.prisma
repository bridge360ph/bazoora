generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  GOVERNMENT_ADMIN
  HAULING_ADMIN
  DRIVER
  ECO_AIDE
  BUSINESS
  RESIDENT
}

model User {
  id              String           @id @default(cuid())
  userNumber      String?          @unique             // user-facing display id, temporarily optional
  email           String           @unique
  name            String?
  password        String
  role            UserRole
  authVersion     Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  driverLocation  DriverLocation?      @relation("DriverLocations")
  assignedTruck   Truck?               @relation("AssignedDriver")
  assignedRoute   Route?               @relation("AssignedEcoAide")
  refreshTokens   RefreshToken[]
  settingsProfile UserSettingsProfile?
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ServiceRequest {
  request_id      String    @id @default(cuid())
  user_id         String
  org_id          String?
  request_address String
  sender_type     String?
  image_url       String?
  pickup_date     DateTime?
  status          String    @default("PENDING")
  approved_by     String?
  approved_at     DateTime?
  note            String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    User     @relation("DriverLocations", fields: [driverId], references: [id])
  truckId   String?
  truck     Truck?   @relation("TruckLocations", fields: [truckId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id               String           @id @default(cuid())
  truckNumber     String?          @unique             // user-facing display id, temporarily optional
  plateNumber      String           @unique
  model            String?
  capacity         String?
  status           String           @default("Active") // "Active" | "Idle" | "Under Maintenance"
  assignedDriverId String?          @unique
  assignedDriver   User?            @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  assignedRoute    Route?           @relation("RouteTruck")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  driverLocations  DriverLocation[] @relation("TruckLocations")
}

model Route {
  id                String   @id @default(cuid())
  routeNumber       Int      @unique
  name              String
  barangay          String
  waypoints         String // Comma separated list of stops/waypoints
  wasteType         String // "Regular" | "Recyclable" | "Regular/Non-Recyclable"
  collectionDay     String // "Sunday" | "Monday" ...
  startTime         String
  status            String   @default("Not Started") // "In Progress" | "Completed" | "Not Started"
  stops             Int      @default(0)
  routeType         String
  assignedEcoAideId String?  @unique
  assignedEcoAide   User?    @relation("AssignedEcoAide", fields: [assignedEcoAideId], references: [id])
  assignedTruckId   String?  @unique
  assignedTruck     Truck?   @relation("RouteTruck", fields: [assignedTruckId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserSettingsProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  firstName          String?
  lastName           String?
  phoneNumber        String?
  streetAddress      String?
  region             String?
  barangay           String?
  cityMunicipality   String?
  province           String?
  postalCode         String?
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  dailySummary       Boolean  @default(false)
  darkMode           Boolean  @default(false)
  autoAssignRoutes   Boolean  @default(true)
  realTimeTracking   Boolean  @default(true)
  automaticReports   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Counter {
  entity   String @id
  sequence Int    @default(0)
}

// Hauling Request Management

enum HaulingRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum WasteType {
  RESIDUAL
  NON_BIODEGRADABLE
  HAZARDOUS
  BIODEGRADABLE
}

enum SenderType {
  RESIDENT
  BUSINESS
}

model HaulingRequest {
  requestId      String               @id @default(cuid())
  requestNumber  String               @unique
  userId         String
  orgId          String?
  requestAddress String
  senderType     SenderType
  wasteType      WasteType
  imageUrl       String?
  pickupDate     DateTime?
  status         HaulingRequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  denialReason   String?
  note           String?
  archived       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}
