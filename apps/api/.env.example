NODE_ENV=development
PORT=3000

# Database. Matches the Postgres container in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazoora

# AWS S3 (only needed for image uploads; leave blank otherwise)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Authentication
# AUTH_SECRET: any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_DAYS=7
# Comma-separated list of frontend URLs allowed to call the API.
# Must include the web dev server, or login fails with a CORS error.
CORS_ORIGIN=http://localhost:5173

# Seed accounts (pnpm --filter @bazoora/api seed:<role>)
# Passwords need 8+ chars with upper, lower, number and special character.
SEED_ADMIN_EMAIL=admin@bazoora.local
SEED_ADMIN_NAME=Bazoora Super Admin
SEED_ADMIN_PASSWORD=

SEED_ECO_AIDE_EMAIL=ecoaide@bazoora.local
SEED_ECO_AIDE_NAME=Test Eco-Aide
SEED_ECO_AIDE_PASSWORD=

SEED_RESIDENT_EMAIL=resident@bazoora.local
SEED_RESIDENT_NAME=Bazoora Test Resident
SEED_RESIDENT_PASSWORD=

SEED_DRIVER_EMAIL=driver@bazoora.local
SEED_DRIVER_NAME=Bazoora Test Driver
SEED_DRIVER_PASSWORD=

# Routing server for snapping collection points onto roads (optional).
# The public demo only allows light use. Self-host OSRM for production.
OSRM_URL=https://router.project-osrm.org
OSRM_MAX_REQUESTS_PER_SECOND=5
