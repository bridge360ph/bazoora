enum UserRole {
  SUPER_ADMIN
  GOVERNMENT_ADMIN
  HAULING_ADMIN
  DRIVER
  ECO_AIDE
  RESIDENT
  BUSINESS
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  fullName  String

  role      UserRole
  status    UserStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}